# ---------- AI vision (server only) ----------
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Any current vision-capable Claude model works.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Nutrition database (server only) ----------
# Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The anon/public key is designed to be exposed; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Needed solely for "Delete my account". Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
